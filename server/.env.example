MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=sutra_dev
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=24h
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dashboard.local
